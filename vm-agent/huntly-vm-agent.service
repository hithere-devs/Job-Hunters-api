[Unit]
Description=Huntly VM browser agent
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/huntly/vm-agent
ExecStart=/usr/bin/node --experimental-strip-types /opt/huntly/vm-agent/server.ts
EnvironmentFile=/etc/huntly/vm-agent.env
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
